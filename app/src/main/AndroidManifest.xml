<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".MITAttendanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MITAttendance"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <service android:name=".campus.CampusMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <activity android:name=".campus.CampusLinkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mitattendance" android:host="campus" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mitasia.in" android:pathPrefix="/akatsuki/" />
            </intent-filter>
        </activity>
        <activity android:name=".campus.CampusAlertsActivity" android:exported="false" />
        <activity android:name=".campus.CampusOpportunitiesActivity" android:exported="false" />
        <receiver android:name=".campus.CampusReminderReceiver" android:exported="false" />
        <activity android:name=".campus.CampusActivity" android:exported="false" />

        <receiver
            android:name=".ui.alerts.AlertReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".ui.login.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MITAttendance.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.subjects.SubjectsActivity"
            android:exported="false"
            android:label="My Attendance"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.subjects.UpdateInstallActivity"
            android:exported="false"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.subjects.NotesLibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.subjects.NotesActivity"
            android:exported="true"
            android:label="File Explorer"
            android:parentActivityName=".ui.subjects.SubjectsActivity"
            android:theme="@style/Theme.MITAttendance">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>



        <activity
            android:name=".ui.subjects.CustomizeActivity"
            android:exported="false"
            android:label="Customize"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.subjects.ErpWebViewActivity"
            android:exported="false"
            android:label="ERP"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.subjects.GenericWebViewActivity"
            android:exported="false"
            android:label="Web View"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.subjects.ExamCellWebViewActivity"
            android:exported="false"
            android:label="Exam Cell"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.subjects.ExamCellLoginActivity"
            android:exported="false"
            android:label="Exam Cell Login"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.detail.AttendanceDetailActivity"
            android:exported="false"
            android:label="Attendance Details"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.subjects.AttendanceSubjectsActivity"
            android:exported="false"
            android:label="Overall Attendance"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.practical.PracticalActivity"
            android:exported="false"
            android:label="Practicals"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.practical.PracticalListActivity"
            android:exported="false"
            android:label="Practical List"
            android:parentActivityName=".ui.practical.PracticalActivity" />

        <activity
            android:name=".ui.practical.SubmitPracticalActivity"
            android:exported="false"
            android:label="Submit Practical"
            android:parentActivityName=".ui.practical.PracticalListActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.practical.ChatGPTWebViewActivity"
            android:exported="false"
            android:label="ChatGPT AI"
            android:theme="@style/Theme.MITAttendance" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:label="Public Chat"
            android:parentActivityName=".ui.subjects.SubjectsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.reviews.ReviewsActivity"
            android:exported="false"
            android:label="Reviews"
            android:parentActivityName=".ui.subjects.SubjectsActivity" />

        <activity
            android:name=".ui.timetable.TimetableActivity"
            android:exported="false"
            android:label="Timetable"
            android:parentActivityName=".ui.subjects.SubjectsActivity"
            android:theme="@style/Theme.MITAttendance" />







        <!-- WorkManager's foreground-service host for downloading APK updates.
             The ApkDownloadWorker calls setForeground() with type DATA_SYNC, so the
             system service hosting it must declare that foregroundServiceType. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- MITAttendanceApp implements androidx.work.Configuration.Provider, so
             WorkManager is initialized on-demand and the default startup
             initializer node must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ui.alerts.AlertsActivity"
            android:exported="false"
            android:label="Class Alerts"
            android:parentActivityName=".ui.subjects.SubjectsActivity"
            android:theme="@style/Theme.MITAttendance" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>

    </application>

</manifest>
