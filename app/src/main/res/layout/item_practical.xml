<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:rippleColor="@color/medkit_cream_2"
    app:strokeColor="@color/medkit_line"
    app:strokeWidth="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPracticalNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/quicksand"
                android:textAllCaps="true"
                android:textColor="@color/medkit_peach_deep"
                android:textSize="13sp"
                tools:text="Practical 01" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_status_submitted"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Completed" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPracticalAim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito"
            android:maxLines="3"
            android:textColor="@color/medkit_ink"
            android:textSize="15sp"
            tools:text="Design and develop a mobile application to demonstrate the use of UI components." />

        <TextView
            android:id="@+id/tvPracticalDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/medkit_ink_2"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Write, test, and submit the supporting theory, code, and output for the experiment."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvStatusMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/medkit_ink_2"
            android:textSize="12sp"
            tools:text="Saved locally at 10:42 AM • Server verified at 11:05 AM" />

        <TextView
            android:id="@+id/tvActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:text="Tap to view details or submit"
            android:textColor="@color/medkit_ink_soft"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
