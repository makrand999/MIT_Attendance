<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:rotation="-0.35"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="5dp"
        app:strokeColor="@color/medkit_line"
        app:strokeWidth="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_overview_toggle"
                style="@style/Widget.MITAttendance.MedKitButton.Peach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconTint="@color/medkit_ink"
                app:strokeColor="@color/medkit_line" />

            <LinearLayout
                android:id="@+id/overview_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_percentage_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:text="0%"
                    android:textColor="@color/medkit_ink"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    tools:text="78%" />

                <TextView
                    android:id="@+id/tv_status_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pull to refresh the latest attendance timeline."
                    android:textColor="@color/medkit_ink"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classes"
                            android:textColor="@color/medkit_ink_2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_stats_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0/0"
                            android:textColor="@color/medkit_ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="19 present / 21 total" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_needed_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need for 75%"
                            android:textColor="@color/medkit_ink_2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_needed_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/medkit_ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="2 classes" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_alerts"
                        style="@style/Widget.MITAttendance.MedKitButton.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Alerts"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_alert"
                        app:iconPadding="8dp"
                        app:strokeColor="@color/medkit_line" />

                    <TextView
                        android:id="@+id/tv_timeline_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Swipe left for subject alerts"
                        android:textColor="@color/medkit_ink_2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
