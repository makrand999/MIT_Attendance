<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_medkit_screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_medkit_screen"
        tools:ignore="ContentDescription" />

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="34dp"
            android:paddingTop="80dp"
            android:paddingEnd="34dp"
            android:paddingBottom="80dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:rotation="-0.65"
                app:cardBackgroundColor="@color/medkit_peach"
                app:cardCornerRadius="34dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/medkit_line"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_login_panel"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <!-- Email -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            style="@style/Widget.MITAttendance.LoginInput"
                            app:hintEnabled="false"
                            app:startIconDrawable="@android:drawable/ic_dialog_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_email"
                                android:inputType="textEmailAddress"
                                android:imeOptions="actionNext"
                                android:textColor="@color/medkit_ink"
                                android:textColorHint="@color/medkit_ink_soft"
                                android:paddingVertical="16dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            style="@style/Widget.MITAttendance.LoginInput"
                            app:hintEnabled="false"
                            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                            app:passwordToggleEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_password"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone"
                                android:textColor="@color/medkit_ink"
                                android:textColorHint="@color/medkit_ink_soft"
                                android:paddingVertical="16dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Semester picker trigger -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_semester"
                            style="@style/Widget.MITAttendance.LoginInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            app:endIconDrawable="@drawable/ic_expand_more"
                            app:endIconMode="custom"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/spinner_semester"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:hint="@string/hint_semester"
                                android:inputType="none"
                                android:padding="16dp"
                                android:textColor="@color/medkit_ink"
                                android:textColorHint="@color/medkit_ink_soft" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Status -->
                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_medkit_chip_white"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/medkit_rose_deep"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Login button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_login"
                                style="@style/Widget.MITAttendance.MedKitButton.Peach"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:text="@string/btn_login"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textAllCaps="false" />

                            <ProgressBar
                                android:id="@+id/progress_bar"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="18dp"
                                android:indeterminateTint="@color/medkit_line"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/semester_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:alpha="0"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:translationY="-18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_1"
                        style="@style/Widget.MITAttendance.MedKitButton.Peach"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="-3.5"
                        android:text="1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_2"
                        style="@style/Widget.MITAttendance.MedKitButton.Mint"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="2.5"
                        android:text="2"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_3"
                        style="@style/Widget.MITAttendance.MedKitButton.Sky"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="-1.5"
                        android:text="3"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_4"
                        style="@style/Widget.MITAttendance.MedKitButton.Peach"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="3"
                        android:text="4"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_5"
                        style="@style/Widget.MITAttendance.MedKitButton.Mint"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="2"
                        android:text="5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_6"
                        style="@style/Widget.MITAttendance.MedKitButton.Sky"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="-2.5"
                        android:text="6"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_7"
                        style="@style/Widget.MITAttendance.MedKitButton.Peach"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="3.5"
                        android:text="7"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_semester_8"
                        style="@style/Widget.MITAttendance.MedKitButton.Mint"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:rotation="-1"
                        android:text="8"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
