# Copy this file to secrets.properties at the repo root and fill in real values.
# secrets.properties is gitignored and MUST NEVER be committed.
#
# These values are read by app/build.gradle and exposed via BuildConfig.


# Optional public Firebase Android configuration. Leave empty to keep push disabled.
# Never put a Firebase service-account private key or server credential here.
FIREBASE_PROJECT_ID=
FIREBASE_APPLICATION_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
